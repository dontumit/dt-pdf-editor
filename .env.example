# ============================================================
# DT PDF Editor — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ตรงกับระบบของคุณ
# ห้าม commit ไฟล์ .env เข้า git เด็ดขาด
# ============================================================

# ---------- Application ----------
APP_NAME="DT PDF Editor"
NODE_ENV=production
PORT=8080
# URL สาธารณะของระบบ (ใช้สร้าง LINE callback + share link)
PUBLIC_BASE_URL=https://pdf.example.ac.th
# เวอร์ชันสำหรับ cache busting ของ static asset (เปลี่ยนทุกครั้งที่ deploy)
CACHE_VERSION=1.0.0

# ---------- Security ----------
# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างด้วย: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
SESSION_COOKIE_NAME=dtpdf_session
# อายุ token ผู้ใช้ (วินาที) ค่าเริ่มต้น 7 วัน
JWT_TTL_SECONDS=604800
# ตั้งเป็น false เฉพาะตอน dev บน http://localhost
COOKIE_SECURE=true
# domain ที่อนุญาตให้เรียก API แบบ cross-origin (คั่นด้วย ,) เว้นว่าง = same-origin เท่านั้น
CORS_ORIGINS=

# ---------- Database ----------
# SQLite (ค่าเริ่มต้น) — เปลี่ยน path ได้ตามต้องการ
DATABASE_URL=file:./data/dtpdf.db

# ---------- Storage (ไฟล์ชั่วคราวเท่านั้น) ----------
STORAGE_DIR=./storage
# อายุไฟล์ชั่วคราวก่อนถูกลบอัตโนมัติ (วินาที) ค่าเริ่มต้น 30 นาที
TEMP_FILE_TTL=1800
# รอบการทำงานของ cleanup worker (วินาที)
CLEANUP_INTERVAL=300

# ---------- Limits ----------
MAX_FILE_SIZE_MB=100
MAX_PDF_PAGES=500
MAX_CONCURRENT_JOBS=2
PROCESSING_TIMEOUT_SECONDS=180
# true = รันคิวงานในโปรเซสเดียวกับ API (ติดตั้งเครื่องเดียว)
# false = ใช้ worker แยก container (รัน server/src/workers/standalone.js)
RUN_INLINE_WORKER=true
# Rate limit ต่อชั่วโมง
RATE_LIMIT_GUEST=20
RATE_LIMIT_USER=100

# ---------- Presence / Analytics ----------
# ช่วงเวลาที่ browser ส่ง heartbeat (วินาที)
HEARTBEAT_INTERVAL=25
# ไม่ส่ง heartbeat เกินกี่วินาทีถือว่า offline
ONLINE_TIMEOUT=75
# เก็บ analytics ย้อนหลังกี่วัน (PDPA: เก็บเท่าที่จำเป็น)
ANALYTICS_RETENTION_DAYS=90

# ---------- LINE Login / LIFF / Messaging ----------
# จาก LINE Developers Console > Channel (LINE Login)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LIFF ID สำหรับเปิดใน LINE (ตัวอย่าง 1234567890-abcdEFGH)
LINE_LIFF_ID=
# จาก Channel (Messaging API) — ใช้สำหรับ Rich Menu / push (ไม่บังคับ)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
# LINE จะ redirect กลับมาที่ path นี้ (ต้องตั้งค่าใน Console ให้ตรงกัน)
LINE_CALLBACK_PATH=/api/auth/line/callback

# ---------- Admin ----------
# อีเมล/LINE userId ของผู้ดูแลระบบ คั่นด้วย , (ผู้ใช้เหล่านี้เข้า /admin ได้)
ADMIN_LINE_USER_IDS=
ADMIN_EMAILS=
# รหัสผ่านสำหรับเข้า /admin แบบ local (ไม่ผ่าน LINE) — เว้นว่างเพื่อปิดช่องทางนี้
ADMIN_LOCAL_USERNAME=admin
ADMIN_LOCAL_PASSWORD=

# ---------- Server-side processors (ไม่บังคับ) ----------
# path ของ binary; เว้นว่างให้ระบบค้นหาจาก PATH เอง
QPDF_BIN=qpdf
GHOSTSCRIPT_BIN=gs
# ภาษาสำหรับ OCR ฝั่ง server
OCR_LANGS=tha+eng

# ---------- LINE Official Account (ประตูเพิ่มเพื่อน) ----------
# บังคับให้ผู้ใช้เพิ่มเพื่อน OA ก่อนเข้าใช้งาน (true/false)
REQUIRE_LINE_FRIEND=true
# Basic ID ของ OA เช่น @123abcd (ใช้สร้างลิงก์เพิ่มเพื่อน)
LINE_OA_BASIC_ID=
# ชื่อหน่วยงานที่แสดงใต้ชื่อระบบบนหน้าแรก (เว้นว่างไว้ได้ ระบบจะแสดงคำโปรยแทน)
ORG_NAME=

# ---------- เครดิตผู้พัฒนา ----------
# ข้อความบรรทัดล่างสุดของหน้า แสดงเป็นตัวเล็กสีเทาจาง (เว้นว่างเพื่อไม่แสดง)
CREDIT_TEXT="พัฒนาโดย นางสาวชุติมา วัจรินทร์ นักวิชาการคอมพิวเตอร์ โรงพยาบาลดอนตูม"
